# Per-device calibration. Copy to `.env` and tune for YOUR camera:
#
#   cp .env.example .env
#   uv run python testdata/verify_scores.py
#
# These are camera- and scene-dependent, not code-dependent. The defaults are
# calibrated on an Arducam 1080P at 1280x720 on a desk. A different camera,
# distance, or lighting moves the scores, so re-run the calibration script
# after you copy this file. The README section "Calibrating for your camera"
# walks through reading its output.

# --- recognition ------------------------------------------------------------

# How close the nearest taught view must be to count as a recognition.
# CLIP cosine similarity has a high floor: two unrelated crops from the same
# camera routinely land at 0.75-0.85, so this is NOT "90% confident" — it is a
# knee in your camera's score distribution. verify_scores.py prints it.
# Too low: everything in the room matches the last thing you taught.
# Too high: the object stops being recognized when it turns or the light shifts.
RECOGNIZE_THRESHOLD=0.90

# --- detection --------------------------------------------------------------

# Detector confidence floor. Raise to track less clutter, lower to notice more.
DETECT_CONF=0.30

# Largest proposal kept, as a fraction of the frame. Drops torso- and
# wall-sized phantom boxes. Raise it if your camera sits far enough back that
# the things you want to teach are small in frame.
DETECT_MAX_AREA=0.20

# Smallest proposal kept, the other end of the same band. Raise it if small
# far-away things keep stealing the unknown box from what you are holding up.
# This is AREA, so it goes as the square of apparent size: doubling it makes
# the smallest tracked object about 40% wider, not twice as wide.
DETECT_MIN_AREA=0.001

# --- camera -----------------------------------------------------------------

# How your camera is mounted, in degrees: 0 if it sits the right way up, 180
# if it is fixed upside down (which is how it ends up in the robot chassis).
# Set this BEFORE you teach anything. CLIP is not rotation-invariant, so a
# memory taught through an upside-down feed will not match the same object
# once the picture is the right way up — changing this later means re-teaching.
# Only 0 and 180 work; a quarter turn would swap the frame's width and height,
# and the rest of the app is written for a landscape frame.
CAMERA_ROTATE=0
